---
BasedOnStyle: LLVM
Language: Cpp
Standard: c++20
IndentWidth: 4
ColumnLimit: 100
AccessModifierOffset: -4
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLambdasOnASingleLine: All
AlwaysBreakTemplateDeclarations: Yes
BreakBeforeBraces: Attach
DerivePointerAlignment: false
PointerAlignment: Left
IncludeBlocks: Regroup
# A file's own header comes first, so every header is proven to compile on its
# own. Tests treat the header under test as their own.
MainIncludeChar: Any
IncludeIsMainRegex: "(_tests)?$"
IncludeCategories:
  - Regex: "^<waveform/"
    Priority: 3
  - Regex: "^<(juce_|catch2/)"
    Priority: 2
  - Regex: "^<"
    Priority: 1
  - Regex: ".*"
    Priority: 4
NamespaceIndentation: None
SortIncludes: CaseSensitive
---
Language: ObjC
DisableFormat: true
