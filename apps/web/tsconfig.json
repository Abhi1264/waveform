{
  "extends": "../../packages/config/tsconfig/next.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@waveform/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "out"]
}
