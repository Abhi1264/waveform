{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "boundaries": {
    "tags": {
      "app": {
        "dependents": {
          "deny": ["app", "ui", "lib", "config"]
        }
      },
      "ui": {
        "dependencies": {
          "deny": ["app"]
        }
      },
      "lib": {
        "dependencies": {
          "deny": ["app", "ui"]
        }
      },
      "config": {
        "dependencies": {
          "deny": ["app", "ui", "lib"]
        }
      }
    }
  }
}
